                    contador++;

                    if (numero < 0)
                    {
                        Console.WriteLine("Numero menor: " + numeromenor);

                    }
                    else if (numeromenor > numero)
                    {
                        numeromenor = numero;


                    }

                      



            } while (numero > 0);





        }
