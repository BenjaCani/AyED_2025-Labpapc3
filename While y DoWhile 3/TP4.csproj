namespace TP4
{
    class Program
    {
        static void Main(string[] args)
        {
            int numero= 0;
            int numeromenor = 0;
            int contador = 0;

            Console.WriteLine("Ingrese la lista de numeros positivos: ");
            numeromenor = int.Parse(Console.ReadLine());
            contador++;

            do
            {
           
                    Console.WriteLine("Ingrese la lista de numeros positivos: ");
